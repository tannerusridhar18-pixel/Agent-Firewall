DB_HOST=localhost
DB_PORT=3306
DB_NAME=agentfirewall
DB_USERNAME=your_mysql_username
DB_PASSWORD=your_mysql_password
SERVER_PORT=8080

# Step 5: Security Agent & AI Provider Configuration
INTENTGUARD_SECURITY_AGENT_ENABLED=true
INTENTGUARD_RISK_BLOCK_THRESHOLD=0.80
INTENTGUARD_RISK_FLAG_THRESHOLD=0.40
INTENTGUARD_AI_ENABLED=false
INTENTGUARD_AI_PROVIDER=openai
INTENTGUARD_AI_API_KEY=your_ai_api_key_here
INTENTGUARD_AI_ENDPOINT=https://api.openai.com/v1/chat/completions
INTENTGUARD_AI_MODEL=gpt-4o-mini
INTENTGUARD_AI_TIMEOUT_MS=3000

