# ==============================================================================
# AgentFirewall .gitignore
# Excludes sensitive, local-only, generated, and environment-specific files
# ==============================================================================

# ------------------------------------------------------------------------------
# Environment Variables, Secrets & Credentials
# ------------------------------------------------------------------------------
.env
.env.*
*.env
*.env.*
!.env.example
!*.env.example
!**/.env.example

# Local credentials, certificates, keys & secrets
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12
*.jks
*.keystore
secrets.json
credentials.json
*credentials*
*secret*.properties

# ------------------------------------------------------------------------------
# Spring Boot / Backend Local Configuration
# ------------------------------------------------------------------------------
application-local.yml
application-local.yaml
application-*.local.yml
application-*.local.yaml
**/application-local.yml
**/application-local.yaml

# ------------------------------------------------------------------------------
# Java & Maven Build Outputs
# ------------------------------------------------------------------------------
target/
**/target/
*.class
*.jar
*.war
*.ear
*.nar

# Maven wrapper and release artifacts
!/.mvn/wrapper/maven-wrapper.jar
!**/.mvn/wrapper/maven-wrapper.jar
.mvn/timing.properties
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
release.properties
dependency-reduced-pom.xml
buildNumber.properties

# ------------------------------------------------------------------------------
# Node.js, Frontend & Build Outputs
# ------------------------------------------------------------------------------
node_modules/
**/node_modules/
.next/
**/.next/
out/
**/out/
build/
**/build/
dist/
**/dist/
.turbo/
coverage/
**/coverage/
*.tsbuildinfo
.eslintcache

# Package manager logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ------------------------------------------------------------------------------
# Logs & Runtime Diagnostics
# ------------------------------------------------------------------------------
*.log
logs/
**/logs/
log/
**/log/
*.stackdump

# ------------------------------------------------------------------------------
# Databases, Local Storage & Docker Runtime Artifacts
# ------------------------------------------------------------------------------
*.sqlite
*.sqlite3
*.db
*.db-journal
*.dump
*.sql.gz
*.bak
tmp/
**/tmp/
temp/
**/temp/
data/
**/data/
intentguard_mysql_data/
agentfirewall_mysql_data/

# ------------------------------------------------------------------------------
# IDEs & Editor Configuration
# ------------------------------------------------------------------------------
# JetBrains (IntelliJ IDEA)
.idea/
**/.idea/
*.iml
*.iws
*.ipr

# Visual Studio Code
.vscode/
**/.vscode/

# Eclipse
.classpath
.project
.settings/
**/.settings/

# NetBeans
nbproject/private/
nbbuild/
nbdist/
.nb-gradle/

# General editor backups and temporary files
*.swp
*.swo
*~
*.bak

# ------------------------------------------------------------------------------
# OS-specific Files
# ------------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Thumbs.db:encryptable
desktop.ini
$RECYCLE.BIN/
